# Environment
.env
.env.local

# Claude Code harness runtime logs
.claude/hooks/.logs/

# Python (api/)
api/.venv/
api/**/__pycache__/
**/__pycache__/
*.pyc
# LiqTide has no historical endpoint — an uncaptured day is gone forever, so
# cache/liqtide/ is tracked while every other cache subdir (regenerable from
# its source API on demand) stays ignored. The `*` is required: git cannot
# un-ignore a path inside a directory excluded by a bare directory pattern,
# so the parent must be excluded per-entry for the negation to take effect.
api/data/cache/*
!api/data/cache/liqtide/
# Narrative forward-archive (RFC-4): pytrends/Google Trends and Reddit
# keep no history server-side, so nightly points are committed like LiqTide.
# The CoinGecko trending snapshot is a single overwritten "right now" file,
# not an archive, so it stays ignored (re-ignored after the negation).
!api/data/cache/narrative/
api/data/cache/narrative/coingecko_trending.parquet
# Chain-growth archive (chain-growth RFC-3): provider revisions and possible
# loss of deep history make the nightly merged series worth keeping.
!api/data/cache/onchain/
api/data/watchlist.json

# Node (web/)
node_modules/
web/.next/
web/node_modules/

# Playwright E2E (see web/playwright.config.ts)
web/test-results/
web/playwright-report/
web/blob-report/
web/.playwright/
# Generated by api/scripts/seed_e2e_cache.py on every E2E run.
web/e2e/.fixture-manifest.json

# OS
.DS_Store

# Built Svelte/LayerChart islands (pnpm build:islands)
web/public/islands/
